// posts.schema.json - 论坛帖子表
{
  "bsonType": "object",
  "required": ["title", "content"],
  "permission": {
    "read": true,
    "create": "auth.uid != null",
    "update": "doc.authorId == auth.uid",
    "delete": "doc.authorId == auth.uid"
  },
  "properties": {
    "title": { "bsonType": "string", "maxLength": 100, "trim": "both" },
    "content": { "bsonType": "string", "maxLength": 10000 },
    "authorId": { "bsonType": "string", "forceDefaultValue": { "$env": "uid" } },
    "category": { "bsonType": "string", "enum": ["欧洲战场", "太平洋战争", "名将评析", "武器装备", "战术推演", "资源分享", "其他"] },
    "tags": { "bsonType": "array", "items": { "bsonType": "string" } },
    "likeCount": { "bsonType": "int", "defaultValue": 0 },
    "viewCount": { "bsonType": "int", "defaultValue": 0 },
    "commentCount": { "bsonType": "int", "defaultValue": 0 },
    "isPinned": { "bsonType": "bool", "defaultValue": false },
    "createTime": { "bsonType": "timestamp", "forceDefaultValue": { "$env": "now" } }
  }
}
