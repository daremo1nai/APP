// quizRecords.schema.json - 用户答题记录
{
  "bsonType": "object",
  "required": ["questionId", "userAnswer", "isCorrect"],
  "permission": {
    "read": "doc.userId == auth.uid",
    "create": "auth.uid != null",
    "update": false,
    "delete": false
  },
  "properties": {
    "userId": { "bsonType": "string", "forceDefaultValue": { "$env": "uid" } },
    "questionId": { "bsonType": "string" },
    "userAnswer": { "bsonType": "int" },
    "isCorrect": { "bsonType": "bool" },
    "answeredAt": { "bsonType": "timestamp", "forceDefaultValue": { "$env": "now" } }
  }
}
